# Meta App Dashboard > App Settings > Basic
META_APP_ID=
META_APP_SECRET=

# Meta App Dashboard > WhatsApp > Embedded Signup > your signup configuration
META_CONFIG_ID=

# Any string you choose. Meta sends it back on webhook verification (GET /webhook)
# so you can confirm the request came from your own setup.
META_WEBHOOK_VERIFY_TOKEN=

# Graph API version to call.
GRAPH_API_VERSION=v21.0

PORT=3000

# Public HTTPS origin this app is reachable at (ngrok URL in dev, your real
# domain in production). Used only to pre-fill the webhook override URL field
# in the UI — not required to be set.
BASE_URL=

# Keep true while recording Meta App Review videos / testing manually.
# Turn off (or delete src/routes/test.ts) once you no longer need the
# send-message / create-template buttons, since they hold WABA access
# tokens in memory to work.
ENABLE_TEST_FEATURES=true
