rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // One doc per onboarded phone number, keyed by phoneNumberId, with the
    // wabaId and the owning userId as fields. Created, and given its encrypted
    // access token, only by Functions (Admin SDK, which bypasses these rules).
    //
    // The owner can read their own docs (the encrypted token is unreadable
    // without their API key) and may change only overrideUrl and activatedAt
    // themselves. Everything else, including lastRelayCall and usage (the basis
    // for billing) and the token, is Function-written.
    match /wabas/{phoneNumberId} {
      allow read: if isOwner(resource.data.userId);

      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['overrideUrl', 'activatedAt']);
    }

    // A user can read their own doc, so the page can compare a typed API key with
    // apiKeyHash for instant feedback (the hash can't decrypt anything: it is
    // derived under a different label than the encryption key). Writes are
    // Function-only, and the Functions re-check the key themselves every time.
    match /users/{userId} {
      allow read: if isOwner(userId);
    }

    // phoneIndex/{phone} and otps/{phone} have no rules, so no browser can read or
    // write them: they are touched by Functions only.

    // Waitlist click counter: written only by the joinWaitlist Function (Admin
    // SDK, which bypasses rules). Anyone can read the total so pages can show
    // it, but a browser can't change it.
    match /meta/waitlist {
      allow read: if true;
      allow write: if false;
    }

    function isOwner(ownerUid) {
      return request.auth != null && request.auth.uid == ownerUid;
    }
  }
}
