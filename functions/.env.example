# Copy to .env and fill in real values. .env is gitignored — never commit
# it. Used identically by the emulator (npm run serve/test) and deployed
# functions (npm run deploy packages whatever's on disk in this directory).

# App Dashboard → App Settings → Basic
META_APP_ID=
META_APP_SECRET=

# Any string you choose. Sent to a business's endpoint during the
# check-endpoint verification handshake, and to Meta when subscribing —
# doesn't need to match anything Meta-issued, just stay consistent. It must
# equal WEBHOOK_VERIFY_TOKEN in public/assets/app-config.js, which the WABA page
# shows to people setting up the test chatbot.
WEBHOOK_VERIFY_TOKEN=

# watobot.xyz (mudbot) API key — sends the login OTP over WhatsApp.
# https://github.com/pocha/mudbot
WATOBOT_API_KEY=
