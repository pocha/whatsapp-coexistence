# Same value as WEBHOOK_VERIFY_TOKEN in functions/.env
WEBHOOK_VERIFY_TOKEN=

# The access token shown once at the end of onboarding (wizard step 3).
# Leave empty until then: the bot will log messages but not reply.
ACCESS_TOKEN=

# Where replies are sent. Default is the local Functions emulator; for a
# deployed backend use https://us-central1-<project-id>.cloudfunctions.net/relayMessage
# RELAY_BASE=
